{
  "name": "playwright-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "UI test automation framework (Playwright + TypeScript) for the Tricentis Demo Web Shop",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:cases": "playwright test --grep @regression --project=chromium --no-deps",
    "test:cases:headed": "playwright test --grep @regression --project=chromium --no-deps --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results -o allure-report --clean",
    "report:allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.5",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
